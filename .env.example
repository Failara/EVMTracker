# Copy this file to .env and replace every empty secret before starting Compose.

WATCHLIST_DB_NAME=evmtracker_watchlist
WATCHLIST_DB_USER=evmtracker_watchlist
WATCHLIST_DB_PASSWORD=

INDEXER_DB_NAME=evmtracker_indexer
INDEXER_DB_USER=evmtracker_indexer
INDEXER_DB_PASSWORD=

NOTIFICATION_DB_NAME=evmtracker_notification
NOTIFICATION_DB_USER=evmtracker_notification
NOTIFICATION_DB_PASSWORD=

TELEGRAM_DB_NAME=evmtracker_telegram_gateway
TELEGRAM_DB_USER=evmtracker_telegram_gateway
TELEGRAM_DB_PASSWORD=

RABBITMQ_USER=evmtracker
RABBITMQ_PASSWORD=

# The checked-in network catalog supports Sepolia by default.
EVM_NETWORK_NAME=sepolia
EVM_CHAIN_ID=11155111
EVM_RPC_URL=
EVM_START_BLOCK=0
EVM_CONFIRMATION_DEPTH=12

TELEGRAM_BOT_TOKEN=

TRACE_SAMPLING_RATIO=1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
