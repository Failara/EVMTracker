{
  "ConnectionStrings": {
    "Watchlist": ""
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "OutboxDispatch": {
    "BatchSize": 100,
    "PollInterval": "00:00:01",
    "MaximumDeliveryAttempts": 10,
    "InitialRetryDelay": "00:00:02",
    "MaximumRetryDelay": "00:05:00"
  },
  "Observability": {
    "EnablePrometheus": true,
    "PrometheusPath": "/metrics",
    "OtlpEndpoint": "",
    "TraceSamplingRatio": 1.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
